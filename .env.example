# Шаблон настроек. Скопируйте этот файл в .env и заполните значения.
# ВАЖНО: настоящие ключи храните только в .env, он не попадёт в git.

# Ключ авторизации (Authorization key) из личного кабинета GigaChat API.
# Вставьте его целиком, без слова Basic и без кавычек.
GIGACHAT_CREDENTIALS=

# Область доступа. Для физических лиц — GIGACHAT_API_PERS.
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель: GigaChat-2-Pro (баланс качества), GigaChat-2 (быстрее/дешевле) или GigaChat-2-Max.
GIGACHAT_MODEL=GigaChat-2-Pro

# Путь к сертификату Минцифры. Можно оставить пустым:
# приложение само возьмёт certs/russian_trusted_root_ca_pem.crt, если файл есть.
GIGACHAT_CA_BUNDLE_FILE=

# Адреса API. Менять не нужно, если документация GigaChat не потребует иного.
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# Где открывать приложение.
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Битрикс24 -------------------------------------------------------------
# Входящий вебхук с правами crm, task и im.
# Формат: https://<портал>.bitrix24.ru/rest/<id_пользователя>/<токен>/
# Это секрет: не публикуйте его и не добавляйте в git.
B24_URL=

# Ответственный за контакт, сделку и задачу.
# Пусто — владелец вебхука (ID из URL).
B24_RESPONSIBLE_ID=

# Источник заявки в CRM. Должен существовать в справочнике источников.
B24_SOURCE_ID=WEB

# Воронка и стадия сделки. Пустая стадия — первая стадия воронки.
B24_CATEGORY_ID=0
B24_STAGE_ID=

# Создание задачи: needs_human — только если ИИ просит человека,
# always — для каждой заявки, never — не создавать.
B24_TASK_MODE=needs_human

# Уведомление в Битрикс24: all — всегда, needs_human — только для таких заявок,
# never — не отправлять.
B24_NOTIFY_MODE=all

# Добавлять комментарий в таймлайн контакта: true/false.
B24_TIMELINE_COMMENT=true

# Таймаут одного запроса к Битрикс24 в секундах.
B24_TIMEOUT=10

# --- Журнал анонимизации ----------------------------------------------------
# CSV-журнал событий: время, ID запроса, статус, модель, счётчики найденных
# сущностей и SHA-256 замаскированного текста. Сам текст заявки и реальные
# персональные данные в журнал не записываются.
ANONYMIZATION_LOG_ENABLED=true

# Путь относительно папки проекта или абсолютный.
ANONYMIZATION_LOG_FILE=logs/anonymization.csv
